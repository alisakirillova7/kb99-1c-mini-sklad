#Область ОбработчикиСобытий

Процедура ОбработкаПроведения(Отказ, Режим)

	Движения.ОстаткиТоваров.Записывать = Истина;
	Движения.ОборотыТоваров.Записывать = Истина;
	Движения.ОстаткиТоваров.Записать();
	Движения.ОстаткиТоваров.Записывать = Истина;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Остатки.Партия КАК Партия,
	|	Остатки.КоличествоОстаток КАК КоличествоОстаток,
	|	Остатки.СтоимостьОстаток КАК СтоимостьОстаток
	|ИЗ
	|	РегистрНакопления.ОстаткиТоваров.Остатки(&Момент, Товар = &Товар) КАК Остатки
	|ГДЕ
	|	Остатки.КоличествоОстаток > 0
	|УПОРЯДОЧИТЬ ПО
	|	Остатки.Партия.Дата";
	Запрос.УстановитьПараметр("Момент", МоментВремени());

	Для Каждого СтрокаСпискаТоваров Из СписокТоваров Цикл

		КоличествоКСписанию = СтрокаСпискаТоваров.Количество;
		СтоимостьСписания = 0;

		Запрос.УстановитьПараметр("Товар", СтрокаСпискаТоваров.Товар);
		ВыборкаПартий = Запрос.Выполнить().Выбрать();

		Пока ВыборкаПартий.Следующий() И КоличествоКСписанию > 0 Цикл

			КоличествоПартии = Мин(КоличествоКСписанию, ВыборкаПартий.КоличествоОстаток);
			СтоимостьПартии = КоличествоПартии * ВыборкаПартий.СтоимостьОстаток / ВыборкаПартий.КоличествоОстаток;

			Движение = Движения.ОстаткиТоваров.Добавить();
			Движение.ВидДвижения = ВидДвиженияНакопления.Расход;
			Движение.Период = Дата;
			Движение.Товар = СтрокаСпискаТоваров.Товар;
			Движение.Партия = ВыборкаПартий.Партия;
			Движение.Количество = КоличествоПартии;
			Движение.Стоимость = СтоимостьПартии;

			КоличествоКСписанию = КоличествоКСписанию - КоличествоПартии;
			СтоимостьСписания = СтоимостьСписания + СтоимостьПартии;

		КонецЦикла;

		Если КоличествоКСписанию > 0 Тогда
			Сообщить("Не хватает товара " + СтрокаСпискаТоваров.Товар + " на " + КоличествоКСписанию);
			Отказ = Истина;
		КонецЕсли;

		Движение = Движения.ОборотыТоваров.Добавить();
		Движение.Период = Дата;
		Движение.Товар = СтрокаСпискаТоваров.Товар;
		Движение.Количество = СтрокаСпискаТоваров.Количество;

	КонецЦикла;

КонецПроцедуры

#КонецОбласти