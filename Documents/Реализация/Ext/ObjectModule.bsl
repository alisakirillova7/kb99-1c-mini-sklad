#Область ОбработчикиСобытий

Процедура ОбработкаПроведения(Отказ, Режим)

	Движения.ОстаткиТоваров.Записывать = Истина;
	Движения.ОборотыТоваров.Записывать = Истина;
	// Записать() очищает старые движения этого документа и сбрасывает флаг.
	// Флаг включают снова, иначе новое списание не сохранится.
	Движения.ОстаткиТоваров.Записать();
	Движения.ОстаткиТоваров.Записывать = Истина;

	МассивТоваров = СписокТоваров.ВыгрузитьКолонку("Товар");

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Остатки.Товар КАК Товар,
	|	Остатки.Партия КАК Партия,
	|	Поступление.Дата КАК ДатаПартии,
	|	Остатки.КоличествоОстаток КАК КоличествоОстаток,
	|	Остатки.СтоимостьОстаток КАК СтоимостьОстаток
	|ИЗ
	|	РегистрНакопления.ОстаткиТоваров.Остатки(&Момент, Товар В (&МассивТоваров)) КАК Остатки
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.Поступление КАК Поступление
	|		ПО Остатки.Партия = Поступление.Ссылка
	|ГДЕ
	|	Остатки.КоличествоОстаток > 0
	|
	|УПОРЯДОЧИТЬ ПО
	|	ДатаПартии";
	Запрос.УстановитьПараметр("Момент", МоментВремени());
	Запрос.УстановитьПараметр("МассивТоваров", МассивТоваров);
	ТаблицаОстатков = Запрос.Выполнить().Выгрузить();

	Для Каждого СтрокаСпискаТоваров Из СписокТоваров Цикл

		КоличествоКСписанию = СтрокаСпискаТоваров.Количество;
		СтоимостьСписания = 0;

		ОтборПартий = Новый Структура("Товар", СтрокаСпискаТоваров.Товар);
		СтрокиПартий = ТаблицаОстатков.НайтиСтроки(ОтборПартий);

		Для Каждого СтрокаПартии Из СтрокиПартий Цикл

			Если КоличествоКСписанию = 0 Или СтрокаПартии.КоличествоОстаток <= 0 Тогда
				Продолжить;
			КонецЕсли;

			КоличествоПартии = Мин(КоличествоКСписанию, СтрокаПартии.КоличествоОстаток);
			СтоимостьПартии = КоличествоПартии * СтрокаПартии.СтоимостьОстаток / СтрокаПартии.КоличествоОстаток;

			Движение = Движения.ОстаткиТоваров.Добавить();
			Движение.ВидДвижения = ВидДвиженияНакопления.Расход;
			Движение.Период = Дата;
			Движение.Товар = СтрокаСпискаТоваров.Товар;
			Движение.Партия = СтрокаПартии.Партия;
			Движение.Количество = КоличествоПартии;
			Движение.Стоимость = СтоимостьПартии;

			СтрокаПартии.КоличествоОстаток = СтрокаПартии.КоличествоОстаток - КоличествоПартии;
			СтрокаПартии.СтоимостьОстаток = СтрокаПартии.СтоимостьОстаток - СтоимостьПартии;
			КоличествоКСписанию = КоличествоКСписанию - КоличествоПартии;
			СтоимостьСписания = СтоимостьСписания + СтоимостьПартии;

		КонецЦикла;

		Если КоличествоКСписанию > 0 Тогда
			Сообщение = Новый СообщениеПользователю;
			Сообщение.Текст = "Не хватает товара " + Строка(СтрокаСпискаТоваров.Товар) + " на " + КоличествоКСписанию;
			Сообщение.Сообщить();
			Отказ = Истина;
		КонецЕсли;

		Движение = Движения.ОборотыТоваров.Добавить();
		Движение.Период = Дата;
		Движение.Товар = СтрокаСпискаТоваров.Товар;
		Движение.Количество = СтрокаСпискаТоваров.Количество;

	КонецЦикла;

КонецПроцедуры

#КонецОбласти