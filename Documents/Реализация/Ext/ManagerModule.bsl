#Область ПрограммныйИнтерфейс

Функция Печать(МассивДокументов) Экспорт

	ТабличныйДокумент = Новый ТабличныйДокумент;
	Макет = ПолучитьМакет("Печать");

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Реализация.Номер КАК Номер,
	|	Реализация.Дата КАК Дата,
	|	Реализация.СписокТоваров.(
	|		Товар КАК Товар,
	|		Количество КАК Количество
	|	) КАК СписокТоваров
	|ИЗ
	|	Документ.Реализация КАК Реализация
	|ГДЕ
	|	Реализация.Ссылка В (&МассивДокументов)";
	
	Запрос.УстановитьПараметр("МассивДокументов", МассивДокументов);

	ОбластьЗаголовок = Макет.ПолучитьОбласть("Заголовок");
	ОбластьШапка = Макет.ПолучитьОбласть("ШапкаТаблицы");
	ОбластьСтрока = Макет.ПолучитьОбласть("Строка");
	ОбластьИтог = Макет.ПолучитьОбласть("Всего");

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		
		ОбластьЗаголовок.Параметры.Номер = Выборка.Номер;
		ОбластьЗаголовок.Параметры.Дата = Формат(Выборка.Дата, "ДЛФ=D");
		ТабличныйДокумент.Вывести(ОбластьЗаголовок);
		ТабличныйДокумент.Вывести(ОбластьШапка);

		ИтоговоеКоличество = 0;
		ВыборкаСтрок = Выборка.СписокТоваров.Выбрать();
		
		Пока ВыборкаСтрок.Следующий() Цикл
			ОбластьСтрока.Параметры.Заполнить(ВыборкаСтрок);
			ТабличныйДокумент.Вывести(ОбластьСтрока);
			
			ИтоговоеКоличество = ИтоговоеКоличество + ВыборкаСтрок.Количество;
		КонецЦикла;

		ОбластьИтог.Параметры.ВсегоПоДокументу = ИтоговоеКоличество;
		ТабличныйДокумент.Вывести(ОбластьИтог);
		ТабличныйДокумент.ВывестиГоризонтальныйРазделительСтраниц();
		
	КонецЦикла;

	Возврат ТабличныйДокумент;

КонецФункции

#КонецОбласти